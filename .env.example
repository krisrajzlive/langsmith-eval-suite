# LangSmith (experiment tracking; free tier is sufficient)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langsmith-eval-suite

# Application model (system under test)
APP_PROVIDER=openai            # openai | ollama | huggingface | bedrock
APP_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Judge model (use a different model family than the application)
JUDGE_PROVIDER=ollama          # openai | ollama | huggingface | bedrock
JUDGE_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Embeddings
EMBEDDINGS_PROVIDER=lexical    # lexical (offline TF-IDF) | huggingface | openai
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=

# Agent configuration
AGENT_PROMPT_VERSION=v2
RETRIEVAL_TOP_K=4

# Run controls (free-tier friendly)
EVAL_MAX_CONCURRENCY=2
EVAL_NUM_REPETITIONS=1
EVAL_TRACE_EVALUATORS=true       # false reduces LangSmith ingestion on free tiers

# AWS Bedrock (only when APP_PROVIDER or JUDGE_PROVIDER is bedrock). Model ids may need a regional
# inference-profile prefix, e.g. us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
